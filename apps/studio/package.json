{
  "name": "postext-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "stage": "node scripts/stage-public.mjs",
    "dev": "pnpm run stage && vite --host 0.0.0.0",
    "build": "pnpm run stage && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "postext": "workspace:*",
    "postext-sandbox": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.1"
  }
}
